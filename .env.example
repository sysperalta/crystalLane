# Copy to .env and replace every secret. Never commit .env.

# Host port docker compose publishes the adapter on (container always listens on 8080).
ADAPTER_PORT=8080

# demo | production. production is refused by this POC build (all integrations are simulated).
ENV=demo

# Shared secret HappyRobot sends as X-API-Key. Min 16 chars. Comma-separate two keys to rotate.
API_KEY=change-me-to-a-long-random-string

# Legacy TMS (TCP). In docker compose TMS_HOST/TMS_PORT point at the tms-sim service.
# Leave TMS_HOST empty to run the simulator inside the adapter process (single-container deploys).
TMS_HOST=
TMS_PORT=9100
TMS_TOKEN=change-me-tms-token

# Real integrations are not used in this POC; kept so the production wiring is visible.
FMCSA_KEY=
SMS_PROVIDER_KEY=

# --- demo mode only (ENV != production) ---
# MC:phone pairs on file. Any MC listed here that isn't a scripted carrier is treated as active.
DEMO_CARRIERS=123456:+15551234821,654321:+15559876543
# Probability 0-1 of a simulated TMS fault (slow, dropped, garbled). 0.3 shows retries nicely.
TMS_FAULT_RATE=0
# Key for the /demo console (simulated carrier phone + live call timeline). Must differ from API_KEY.
DEMO_CONSOLE_KEY=change-me-demo-console-key
# QA automation only: MC:code pairs whose OTP is always that code (same rules otherwise).
# Leave empty to disable. Never set it in production (the service refuses to start).
QA_TEST_CARRIERS=900001:112233
